# PostgreSQL started by `npm run db:up` (docker-compose.yml)
DATABASE_URL="postgresql://gamplify:gamplify@localhost:5433/gamplify?schema=public"
# API port (the Vite dev server proxies /api to it)
PORT=4000

# Artist discovery (live search). Without SEARCH_PROVIDER_API_KEY, Spotify or YouTube keys, Find artist is switched off.
# SEARCH_PROVIDER=brave (Brave Search API) or google (Programmable Search, also needs GOOGLE_CSE_ID)
SEARCH_PROVIDER=brave
SEARCH_PROVIDER_API_KEY=
GOOGLE_CSE_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Usage limits: protect the free tiers. Counted in the database (restarts do not reset them). 0 = no limit.
# Web search (Brave free plan: 1,000 requests a month, 1 per second)
SEARCH_MONTHLY_LIMIT=500
SEARCH_DAILY_LIMIT=0
SEARCH_QUERIES_PER_ARTIST=8
SEARCH_MIN_INTERVAL_MS=1100
# YouTube Data API (10,000 units a day; one search costs 100 units)
YOUTUBE_MONTHLY_LIMIT=500
YOUTUBE_DAILY_LIMIT=50
YOUTUBE_SEARCHES_PER_ARTIST=3
# Spotify Web API (no fixed quota, short rate-limit windows)
SPOTIFY_MONTHLY_LIMIT=0
SPOTIFY_SEARCHES_PER_ARTIST=6
# 0 switches the public web crawler off (it only reads pages robots.txt allows, never social networks)
CRAWLER_ENABLED=1
