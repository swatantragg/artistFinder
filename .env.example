# Copy to .env and fill in. docker compose reads it; never commit .env.

# PostgreSQL (required). Neon: use the pooled connection string. Migrations use the direct one, derived
# automatically by dropping "-pooler" from the host; set DIRECT_URL yourself for other poolers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require

# Web app port on this machine (http://localhost:8080)
APP_PORT=8080

# Accounts. The first sign-up is the System Owner and needs the owner setup code: OWNER_SETUP_TOKEN, or (when empty)
# a random code the API prints in its log at start-up. Later sign-ups wait for an Admin's approval; ALLOW_SIGNUP=false
# turns asking for an account off (Admins then add people themselves).
ALLOW_SIGNUP=true
OWNER_SETUP_TOKEN=
# Encrypts two-step sign-in secrets in the database. Set a long random value once and keep it: changing it switches
# app codes off for everyone who uses two-step sign-in (their recovery codes still work).   openssl rand -base64 32
AUTH_SECRET=
# Refuse passwords that appear in known data breaches (Have I Been Pwned; only 5 characters of a hash leave the server).
PASSWORD_BREACH_CHECK=true
# Optional Cloudflare Turnstile "I am human" check on sign-up (both keys from the Cloudflare dashboard).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true when the app is served over HTTPS (the session cookie is then only sent over HTTPS)
COOKIE_SECURE=false

# Artist discovery (live search). Without SEARCH_PROVIDER_API_KEY, Spotify or YouTube keys, Find artist is switched off.
SEARCH_PROVIDER=brave
SEARCH_PROVIDER_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Usage limits protect the free tiers. Counted in the database (restarts do not reset them). 0 = no limit.
SEARCH_MONTHLY_LIMIT=500
# SEARCH_DAILY_LIMIT=0
SEARCH_QUERIES_PER_ARTIST=8
SEARCH_MIN_INTERVAL_MS=1100
YOUTUBE_MONTHLY_LIMIT=500
YOUTUBE_DAILY_LIMIT=50
YOUTUBE_SEARCHES_PER_ARTIST=3
SPOTIFY_MONTHLY_LIMIT=0
SPOTIFY_SEARCHES_PER_ARTIST=6
# 0 switches the public web crawler off (it only reads pages robots.txt allows, never social networks)
CRAWLER_ENABLED=1
